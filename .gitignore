# files and journal_tiers.json are durable and tracked.
esearch_*.json
efetch_*.xml
parsed_*.json
fetched_pmids_*.txt
read_pmids_*_sorted.txt
new_pmids_*.txt
new_pmids_*.json
slack_payload_*.json
